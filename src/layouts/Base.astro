---
import css from '../styles/global.css?raw';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  preloadImage?: string;
  noindex?: boolean;
  ads?: boolean;
}

const {
  title,
  description = site.description,
  canonical,
  image,
  preloadImage,
  noindex = false,
  ads = false,
} = Astro.props;

const pageTitle = title ? `${title} - ${site.name}` : `${site.name} ${site.tagline}`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="sitemap" href="/sitemap.xml" />}
    {!noindex && (
      <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss" />
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={new URL(image, site.url).href} />}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <style is:inline set:html={css}></style>
    {ads && (
      <script is:inline>
        (function () {
          var KEY = 'pa_ads_guard';
          var LIMIT = 3;
          var WINDOW_MS = 24 * 60 * 60 * 1000;
          var DEBOUNCE_MS = 1500;
          var CLIENT = 'ca-pub-8094444885520451';
          var armed = false;
          var lastCountAt = 0;
          var scriptLoaded = false;

          function readState() {
            try {
              var data = JSON.parse(localStorage.getItem(KEY) || 'null');
              if (!data || typeof data.startedAt !== 'number' || Date.now() - data.startedAt >= WINDOW_MS) {
                data = { startedAt: Date.now(), clicks: 0 };
                localStorage.setItem(KEY, JSON.stringify(data));
              }
              return data;
            } catch (error) {
              return { startedAt: Date.now(), clicks: 0 };
            }
          }

          function writeState(data) {
            try {
              localStorage.setItem(KEY, JSON.stringify(data));
            } catch (error) {}
          }

          function allowed() {
            return readState().clicks < LIMIT;
          }

          function teardown() {
            document.querySelectorAll('ins.adsbygoogle').forEach(function (node) {
              node.remove();
            });
            document.querySelectorAll('.ad-slot').forEach(function (slot) {
              slot.replaceChildren();
            });
            document.querySelectorAll('script[src*="adsbygoogle.js"]').forEach(function (node) {
              node.remove();
            });
            scriptLoaded = false;
          }

          function recordClick() {
            var data = readState();
            data.clicks += 1;
            writeState(data);
            if (data.clicks >= LIMIT) teardown();
          }

          function isAdTarget(node) {
            return Boolean(node && node.closest && node.closest('.adsbygoogle, .ad-slot'));
          }

          document.addEventListener(
            'pointerover',
            function (event) {
              if (isAdTarget(event.target)) armed = true;
            },
            true,
          );
          document.addEventListener(
            'touchstart',
            function (event) {
              if (isAdTarget(event.target)) armed = true;
            },
            { capture: true, passive: true },
          );
          window.addEventListener('blur', function () {
            if (!armed) return;
            var now = Date.now();
            if (now - lastCountAt < DEBOUNCE_MS) return;
            lastCountAt = now;
            armed = false;
            recordClick();
          });
          document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'visible' && !allowed()) teardown();
          });
          window.addEventListener('pageshow', function () {
            if (!allowed()) teardown();
          });

          window.__paAds = {
            allowed: allowed,
            mount: function (host) {
              if (!host || !allowed()) return;
              var ins = document.createElement('ins');
              var width = host.getAttribute('data-ad-width');
              var height = host.getAttribute('data-ad-height');
              ins.className = 'adsbygoogle';
              ins.setAttribute('data-ad-client', CLIENT);
              ins.setAttribute('data-ad-slot', host.getAttribute('data-ad-slot') || '');
              if (width && height) {
                ins.style.display = 'inline-block';
                ins.style.width = width + 'px';
                ins.style.height = height + 'px';
              } else {
                ins.style.display = 'block';
                ins.setAttribute('data-ad-format', 'auto');
                ins.setAttribute('data-full-width-responsive', 'true');
              }
              host.replaceChildren(ins);
              (window.adsbygoogle = window.adsbygoogle || []).push({});
            },
          };

          window.addEventListener('load', function () {
            if (!allowed() || scriptLoaded) return;
            scriptLoaded = true;
            var script = document.createElement('script');
            script.async = true;
            script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + CLIENT;
            script.crossOrigin = 'anonymous';
            document.head.appendChild(script);
          });
        })();
      </script>
    )}
  </head>
  <body>
    <Header search={!noindex} />
    <main class="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
