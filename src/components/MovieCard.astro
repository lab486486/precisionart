---
import { entryPath, movieDate, type MovieEntry } from '../lib/movies';
import { cardImage } from '../lib/thumbs';

interface Props {
  entry: MovieEntry;
  priority?: boolean;
}

const { entry, priority = false } = Astro.props;
const meta = entry.data.year || movieDate(entry);
const thumb = cardImage(entry.data.thumbnail, 360);
const thumbSmall = cardImage(entry.data.thumbnail, 200);
---

<article class="movie-card">
  <a class="card-link" href={entryPath(entry)}>
    {thumb && (
      <div class="movie-thumb">
        <img
          src={thumbSmall ?? thumb}
          srcset={thumbSmall && thumb ? `${thumbSmall} 200w, ${thumb} 360w` : undefined}
          sizes="(max-width: 700px) 45vw, 180px"
          alt=""
          width="360"
          height="480"
          decoding="async"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'low'}
        />
      </div>
    )}
    <div class="movie-body">
      {meta && <p class="meta">{meta}</p>}
      <p class="movie-name">{entry.data.name}</p>
    </div>
  </a>
</article>
