---
import SearchBox from './SearchBox.astro';

interface Props {
  search?: boolean;
}

const { search = true } = Astro.props;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img class="brand-mark" src="/favicon.svg" alt="" width="34" height="34" />
      <span class="brand-text">
        <span class="brand-name">프리시전아트</span>
        <span class="brand-sub">명장면 좌표</span>
      </span>
    </a>
    {search && (
      <div class="header-search">
        <SearchBox compact inputId="header-q" />
      </div>
    )}
  </div>
</header>
