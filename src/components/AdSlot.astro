---
interface Props {
  adSlot: string;
  label: string;
  width?: number;
  height?: number;
}

const { adSlot, label, width, height } = Astro.props;
const fixed = Boolean(width && height);
---

<div
  class:list={['ad-slot', { 'ad-slot-fixed': fixed }]}
  data-label={label}
  data-ad-slot={adSlot}
  data-ad-width={width}
  data-ad-height={height}
></div>
<script is:inline>
  (function () {
    if (!window.__paAds || !window.__paAds.mount) return;
    window.__paAds.mount(document.currentScript.previousElementSibling);
  })();
</script>
