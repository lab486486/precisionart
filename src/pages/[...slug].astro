---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCategory } from '../lib/categories';
import { entryPath, getMovies } from '../lib/movies';
import { enhanceTimelineHtml } from '../lib/timeline';

export async function getStaticPaths() {
  const entries = await getMovies();
  return entries.map((entry) => ({
    params: { slug: entry.data.entrySlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const catalog = (await getMovies()).map((item) => ({
  name: item.data.name,
  path: entryPath(item),
  slug: item.data.entrySlug,
}));
const html = enhanceTimelineHtml(entry.body ?? '', catalog);
const category = getCategory(entry.data.category);
const canonical = entry.data.canonical ?? entryPath(entry);
---

<Base
  title={entry.data.title}
  description={entry.data.excerpt ?? entry.data.title}
  canonical={canonical}
  image={entry.data.thumbnail}
  ads
>
  <div class="entry-layout">
    <article class="entry-article">
      <p class="breadcrumb">
        <a href="/">프리시전아트</a>
        {category && (
          <>
            / <a href={`/category/${category.slug}/`}>{category.name}</a>
          </>
        )}
        / {entry.data.name}
      </p>
      <h1 class="page-title">{entry.data.title}</h1>
      {entry.data.excerpt && <p class="lede">{entry.data.excerpt}</p>}
      <div class="ad-inarticle">
        <AdSlot adSlot="5384795752" label="본문 중간" />
      </div>
      <div class="prose" set:html={html} />
    </article>
    <aside class="entry-sidebar" aria-label="광고">
      <AdSlot adSlot="7369090567" label="본문 사이드바" width={300} height={600} />
    </aside>
  </div>
</Base>
