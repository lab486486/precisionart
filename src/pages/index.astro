---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import MovieCard from '../components/MovieCard.astro';
import { faqs, popularQueries } from '../data/site';
import { getListedMovies } from '../lib/movies';
import { cardImage } from '../lib/thumbs';

const latest = (await getListedMovies()).slice(0, 10);
const preloadImage = cardImage(latest[0]?.data.thumbnail);
---

<Base preloadImage={preloadImage}>
  <section class="hero">
    <p class="kicker">SCENE INDEX</p>
    <h1>영화 명장면 좌표 검색</h1>
    <p class="lede">국내외 영화의 신스틸러 씬이 몇 분 몇 초에 나오는지 알려드릴께요</p>
    <SearchBox autofocus />
    <div class="chips">
      {popularQueries.map((item) => (
        <a class="chip" href={`/search/?q=${encodeURIComponent(item.query)}`}>{item.label}</a>
      ))}
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section home-movies">
      <div class="movie-grid home-grid">
        {latest.map((entry, index) => (
          <MovieCard entry={entry} priority={index < 2} />
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>자주 하는 질문</h2>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<script>
  const postId = new URLSearchParams(window.location.search).get('p');
  if (postId) {
    fetch('/shortlinks.json')
      .then((response) => response.json())
      .then((map: Record<string, string>) => {
        const dest = map[postId];
        if (dest) window.location.replace(dest);
      })
      .catch(() => undefined);
  }
</script>
